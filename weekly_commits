#!/usr/bin/env python3

import requests
import datetime
import json
from collections import OrderedDict
import os
from dotenv import load_dotenv
import sys
import time

load_dotenv()

MAX_RETRIES = 5
RETRY_DELAY = 3  # seconds

OFFSET_FILE = "/tmp/waybar_github_offset.txt"


cmd = sys.argv[1] if len(sys.argv) > 1 else None

try:
    with open(OFFSET_FILE, 'r') as f:
        offset_weeks = int(f.read().strip())
except Exception:
    offset_weeks = 0

if cmd in ["up", "down", "reset"]:
    if cmd == "up":
        offset_weeks += 1
    elif cmd == "down":
        offset_weeks -= 1
    elif cmd == "reset":
        offset_weeks = 0

    if offset_weeks > 0:
        offset_weeks = 0

    with open(OFFSET_FILE, 'w') as f:
        f.write(str(offset_weeks))
    os.system("pkill -SIGRTMIN+11 waybar")
    sys.exit(0)

# ------------------------------------

output = {}
success = False

GITHUB_USERNAME = os.getenv("GITHUB_USERNAME")
GITHUB_PAT = os.getenv("GITHUB_PAT")

if not GITHUB_USERNAME or not GITHUB_PAT:
    print(json.dumps({"text": "⚠", "tooltip": "Missing Credentials"}))
    sys.exit(1)


actual_today = datetime.date.today()

target_end_date = actual_today + datetime.timedelta(days=offset_weeks * 7)

start_date = target_end_date - datetime.timedelta(days=6)

from_date = start_date.isoformat() + "T00:00:00Z"
to_date = target_end_date.isoformat() + "T23:59:59Z"

query = """
query($user: String!, $from: DateTime!, $to: DateTime!) {
  user(login: $user) {
    contributionsCollection(from: $from, to: $to) {
      contributionCalendar {
        weeks {
          contributionDays {
            date
            contributionCount
            weekday
          }
        }
      }
    }
  }
}
"""

variables = {
    "user": GITHUB_USERNAME,
    "from": from_date,
    "to": to_date
}

headers = {
    "Authorization": f"Bearer {GITHUB_PAT}",
    "Accept": "application/vnd.github.v4.idl"
}

COLOR_SCHEME_PURPLE = {
    0: "#161b22",   # No contributions
    1: "#3d2258",   # 1-3
    2: "#6a3896",   # 4-6
    3: "#974ddb",   # 7-9
    4: "#c463ff"    # 10+
}

def get_color(count):
    if count == 0: return COLOR_SCHEME_PURPLE[0]
    elif 1 <= count <= 3: return COLOR_SCHEME_PURPLE[1]
    elif 4 <= count <= 6: return COLOR_SCHEME_PURPLE[2]
    elif 7 <= count <= 9: return COLOR_SCHEME_PURPLE[3]
    else: return COLOR_SCHEME_PURPLE[4]

def get_weekday_name(weekday):
    return ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"][(weekday + 1) % 7]

for attempt in range(MAX_RETRIES):
    try:
        if attempt > 0:
            time.sleep(RETRY_DELAY)

        response = requests.post(
            "https://api.github.com/graphql",
            json={"query": query, "variables": variables},
            headers=headers,
            timeout=10
        )
        response.raise_for_status()
        data = response.json()

        weeks = data["data"]["user"]["contributionsCollection"]["contributionCalendar"]["weeks"]

        contributions = OrderedDict()
        for i in range(7):
            day = start_date + datetime.timedelta(days=i)
            contributions[day] = 0

        for week in weeks:
            for day in week["contributionDays"]:
                date = datetime.date.fromisoformat(day["date"])
                if start_date <= date <= target_end_date:
                    contributions[date] = day["contributionCount"]

        dots = []
        tooltip_lines = []
        total_contributions = 0

        for date, count in contributions.items():
            color = get_color(count)
            if date == actual_today:
                dots.append(f'<span foreground="{color}" underline="single">■</span>')
            else:
                dots.append(f'<span foreground="{color}">■</span>')
                
            weekday = get_weekday_name(date.weekday())
            tooltip_lines.append(f"{weekday} ({date.day}/{date.month}): {count} contribution{'s' if count != 1 else ''}")
            total_contributions += count

        header_text = "GitHub Contributions"
        if offset_weeks < 0:
            header_text += f" ({abs(offset_weeks)} Weeks Ago)"

        tooltip_text = f"<span size='large' weight='bold'>{header_text}</span>\n<span size='small' color='#a6adc8'>{start_date.strftime('%d/%m')} to {target_end_date.strftime('%d/%m')}</span>\n\nTotal: {total_contributions}\n\n" + "\n".join(tooltip_lines)
        
        if offset_weeks < 0:
            tooltip_text += "\n\n<span size='small' color='#F9E2AF'><i>* Middle-click to return to current week</i></span>"

        prefix = "⏳ " if offset_weeks < 0 else ""

        output = {
            "text": prefix + " ".join(dots),
            "tooltip": tooltip_text,
            "class": "github-contributions",
            "alt": "GitHub Contributions"
        }

        success = True
        break

    except requests.exceptions.RequestException as e:
        if attempt == MAX_RETRIES - 1:
            output = {
                "text": "⚠",
                "tooltip": f"GitHub API error: {str(e)}",
                "class": "error",
                "alt": "GitHub Error"
            }

    except Exception as e:
        output = {
            "text": "⚠",
            "tooltip": f"Error: {str(e)}",
            "class": "error",
            "alt": "Error"
        }
        break

print(json.dumps(output))